[
  {
    "name": "owner",
    "type": "text",
    "label": "Repository owner",
    "required": true,
    "validate": {
      "pattern": "^[A-Za-z0-9-]+$",
      "min": 1
    }
  },
  {
    "name": "repo",
    "type": "text",
    "label": "Repository name",
    "required": true,
    "validate": {
      "pattern": "^[A-Za-z0-9_.-]+$",
      "min": 1
    },
    "help": "Repository name without the .git suffix; no URL or slash."
  },
  {
    "name": "limit",
    "type": "uinteger",
    "label": "Limit",
    "required": true,
    "default": 100,
    "validate": {
      "min": 1,
      "max": 1000
    },
    "help": "Maximum bundles returned per execution; not the API page size."
  }
]
